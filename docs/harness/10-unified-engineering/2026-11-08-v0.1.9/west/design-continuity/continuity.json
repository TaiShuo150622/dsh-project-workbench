  "decision_guide": [
    {
      "id": "Q1",
      "question": "产品交付顺序与 I01 的先行验证怎么并存？",
      "recommended_start": "保留 P→B 产品顺序；先冻结阶段 A，并把 I01 的语义验证单列。",
      "alternative": "经明确范围裁定，先在现有工作台放独立 Record 状态区。",
      "change_evidence": "真实身份入口可验证，独立视图不会造成两套状态/引用契约，且有明确可验证收益。",
      "related": [
        "DC01",
        "DC02"
      ]
    },
    {
      "id": "Q2",
      "question": "业务事实与跨端写入由谁持有？",
      "recommended_start": "沿原单数据目录单写者，工作台管业务、宿主管会话，面板读版本视图。",
      "alternative": "出现跨宿主共享需求后，由统一服务持有存储，或明确独立数据目录。",
      "change_evidence": "实际部署要求多个进程同时写同一项目；原单实例队列无法覆盖所需一致性。",
      "related": [
        "DC03",
        "DC09"
      ]
    },
    {
      "id": "Q3",
      "question": "项目目标和标准由谁确认完成？",
      "recommended_start": "沿用用户确认目标完成，模型提交建议与证据；先补 criteria 修订与来源边界。",
      "alternative": "为明确子类结果制定有范围的委托验收政策，另留用户项目级接受。",
      "change_evidence": "某类标准具备独立可核的判据、可信执行证据及用户认可的委托范围。",
      "related": [
        "DC04",
        "DC05"
      ]
    },
    {
      "id": "Q4",
      "question": "图和面板什么时候可以触发修改？",
      "recommended_start": "继续只读显示、稳定选择、引用和影响提示；操作另走可信命令入口。",
      "alternative": "为少数明确动作增设操作控件，独立冻结参数、批准与反馈。",
      "change_evidence": "只读引用路径反复造成可观测负担，而新控件能保留相同对象/版本并通过负向边界验收。",
      "related": [
        "DC06",
        "DC07"
      ]
    },
    {
      "id": "Q5",
